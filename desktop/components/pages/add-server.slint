import { Button, HorizontalBox, LineEdit, VerticalBox } from "std-widgets.slint";
import { FormBasePage } from "forms.slint";

export component ConnectServerPage inherits FormBasePage {
    page-title: "Connect to server";
    current-form: "login";
    callback login(string, string, string);
    callback use-sso;
    callback create-account;

    property <string> server: serverText.text;
    property <string> email: emailText.text;
    property <string> pwd: passwordText.text;

    VerticalBox {
        spacing: 14px;

        VerticalBox {
            spacing: 6px;

            Text {
                text: "URL";
            }

            serverText := LineEdit {
                placeholder-text: "https://server.example.com";
            }
        }

        VerticalBox {
            spacing: 6px;

            Text {
                text: "Username";
            }

            emailText := LineEdit {
                placeholder-text: "email";
            }
        }

        VerticalBox {
            spacing: 6px;

            Text {
                text: "Password";
            }

            passwordText := LineEdit {
                placeholder-text: "••••••••";
                input-type: password;
            }
        }

        HorizontalBox {
            spacing: 12px;
            alignment: end;

            Button {
                text: "Use SSO";
                clicked => {
                    root.use-sso();
                }
            }

            Button {
                text: "Create Account";
                clicked => {
                    root.create-account();
                }
            }

            Button {
                text: "Submit";
                clicked => {
                    root.login(root.server, root.email, root.pwd);
                }
            }
        }
    }
}