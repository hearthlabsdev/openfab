import { HorizontalBox, VerticalBox, Palette } from "std-widgets.slint";

export component FormBasePage inherits VerticalBox {
    in property <string> page-title: "Form";
    in property <string> current-form: "login";
    
    padding: 24px;
    spacing: 18px;
    min-width: 420px;

    Text {
        text: page-title;
        font-size: 28px;
        font-weight: 600;
    }
}