{# templates/layouts/base.tera #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>{% block title %}OpenFab{% endblock title %}</title>

    <meta name="viewport" content="width=device-width, initial-scale=1">

    {# Global styles #}
    <link id="basetheme" rel="stylesheet" href="/css/base.css">
    <link id="accounttheme" rel="stylesheet" href="/css/accounts.css">

    {# Page-specific styles #}
    {% block head %}{% endblock head %}
</head>

<body>

    <script>
    function togglePassword(id) {
        console.log("toggle password");
        const passwordInput = document.getElementById(id);
        var toggleButton;
        var eyeIcon;
        if (id === 'password') {
            toggleButton = document.querySelector(".password-toggle");
            eyeIcon = toggleButton.querySelector(".eye-icon");
        }
        if (id === 'password2') {
            toggleButton = document.querySelector(".password-toggle2");
            eyeIcon = toggleButton.querySelector(".eye-icon2");
        }
        
        if (passwordInput.type === "password") {
            passwordInput.type = "text";
            toggleButton.setAttribute("aria-label", "Hide password");
            toggleButton.setAttribute("title", "Hide password");

            eyeIcon.innerHTML = `
                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/>
                <circle cx="12" cy="12" r="3"/>
                <line x1="2" y1="2" x2="22" y2="22"/>
            `;
        } else {
            passwordInput.type = "password";
            toggleButton.setAttribute("aria-label", "Show password");
            toggleButton.setAttribute("title", "Show password");

            eyeIcon.innerHTML = `
                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/>
                <circle cx="12" cy="12" r="3"/>
            `;
        }
    }
</script>

    <div class="app">

        {# --- Top Bar --- #}
        <header class="topbar">
            {% block topbar %}
                <div class="topbar-inner">
                    <div class="topbar-left">
                        <a href="/dashboard" class="logo">OpenFab</a>
                    </div>

                    <div class="topbar-center">
                        <input
                            type="text"
                            class="global-search"
                            placeholder="Search devices, jobs, users..."
                        >
                    </div>

                    <div class="topbar-right">
                        {% if user is defined %}
                            <div class="user-menu">
                                <span class="user-name">{{ user.name }}</span>
                            </div>
                        {% endif %}

                        {% if user is defined %}
                            <a href="/account" class="user-menu" title="Account">
                                {{ user.name | slice(start=0, end=1) | upper }}
                            </a>
                        {% else %}
                            <a href="/accounts/login" class="user-menu" title="Login">
                                Login
                            </a>
                        {% endif %}
                    </div>
                </div>
            {% endblock topbar %}
        </header>


        {# --- Optional Context Bar (e.g. device context) --- #}
        {% block context_bar %}{% endblock context_bar %}


        <div class="main">

            {# --- Main Content Area --- #}
            <main class="content">

                {# Optional sub-navigation (tabs, etc.) #}
                {% block subnav %}{% endblock subnav %}

                {# Page content #}
                <div class="page">
                    {% block content %}{% endblock content %}
                </div>

            </main>

        </div>

    </div>

    {# Global scripts #}
    <script src="/static/js/app.js"></script>

    {# Page-specific scripts #}
    {% block scripts %}{% endblock scripts %}
</body>
</html>