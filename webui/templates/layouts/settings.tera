{# templates/layouts/device.tera #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">

    <title>
        {% block title %}OpenFab{% endblock title %}
    </title>

    <meta name="viewport" content="width=device-width, initial-scale=1">

    {# Global styles #}
    <link
        id="basetheme"
        rel="stylesheet"
        href="/css/base.css"
    >

    {# Device-specific styles #}
    <link
        rel="stylesheet"
        href="/css/device.css"
    >

    {# Page-specific head content #}
    {% block head %}{% endblock head %}
</head>

<body>
    <div class="app">

        {# =====================================================
           Top Bar
        ====================================================== #}

        <header class="topbar">

            {% block topbar %}

                <div class="topbar-inner">

                    <div class="topbar-left">
                        <a
                            href="/accounts/dashboard"
                            class="logo"
                        >
                            OpenFab
                        </a>
                    </div>

                    <div class="topbar-center">
                        <input
                            type="text"
                            class="global-search"
                            placeholder="Search devices, jobs, users..."
                        >
                    </div>

                    <div class="topbar-right">

                        <a href="/swagger-ui">
                            docs
                        </a>

                        {% if user is defined %}

                            <div class="user-menu">
                                <span class="user-name">
                                    {{ user.name }}
                                </span>
                            </div>

                            <a
                                href="/account"
                                class="user-menu"
                                title="Account"
                            >
                                {{ user.name
                                    | slice(start=0, end=1)
                                    | upper
                                }}
                            </a>

                        {% else %}

                            <a
                                href="/accounts/login"
                                class="user-menu"
                                title="Login"
                            >
                                Login
                            </a>

                        {% endif %}

                    </div>

                </div>

            {% endblock topbar %}

        </header>


        {# =====================================================
           Device Context
        ====================================================== #}

        {% block context_bar %}

            <div class="context-bar device-context-bar">

                <div class="device-context">

                    <a
                        href="/devices"
                        class="device-context-back"
                    >
                        ← Devices
                    </a>

                    <span class="device-context-separator">
                        /
                    </span>


                </div>

            </div>

        {% endblock context_bar %}


        <div class="main">

            {# =================================================
               Device Navigation
            ================================================== #}

            <aside class="sidebar device-sidebar">

                {% block sidebar %}

                    <nav class="nav">

                        <a href="/accounts/dashboard">
                            Dashboard
                        </a>


                        <div class="nav-section">
                            Settings
                        </div>

                        <a
                            href="/settings/devices/"
                            class=""
                        >
                            Device Profiles
                        </a>

                        <a
                            href="/settings/materials/filaments"
                            class=""
                        >
                            Filament Profiles
                        </a>

                    </nav>

                {% endblock sidebar %}


                {# Allow pages to add content at the bottom of
                   the device sidebar. #}

                {% block sidebar_footer %}{% endblock sidebar_footer %}

            </aside>


            {# =================================================
               Device Content
            ================================================== #}

            <main class="content">
                <div class="page">
                {% block content %}{% endblock content %}
                </div>
            </main>

        </div>

    </div>


    {# =========================================================
       Global Scripts
    ========================================================== #}

    <script src="/static/js/app.js"></script>


    {# =========================================================
       Page-Specific Scripts
    ========================================================== #}

    {% block scripts %}{% endblock scripts %}
    <script>
    document.querySelectorAll(".local-time").forEach(function (element) {
        const unix = Number(element.dataset.unix);

        if (!Number.isNaN(unix)) {
            element.textContent = new Date(unix * 1000).toLocaleString();
        }
    });
</script>
</body>
</html>