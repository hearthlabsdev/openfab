{% extends "layouts/admin" %}

{% block title %}Admin - API Keys{% endblock title %}

{% block content %}

<h1>Admin - API Keys</h1>

<p>
    This is the API key management page. Here you can view and manage API keys.
</p>

<h2>Existing API Keys</h2>

<table class="result-table">
    <thead class="result-table__head">
        <tr class="result-table__row">
            <th class="result-table__header result-table__header--key-id">
                Key ID
            </th>

            <th class="result-table__header result-table__header--owner">
                Owner
            </th>

            <th class="result-table__header result-table__header--owner">
                User Account
            </th>

            <th class="result-table__header result-table__header--access-key">
                Access Key
            </th>

            <th class="result-table__header result-table__header--expires">
                Expires
            </th>

            <th class="result-table__header result-table__header--created">
                Created
            </th>

            <th class="result-table__header result-table__header--actions">
                Actions
            </th>
        </tr>
    </thead>

    <tbody class="result-table__body">
        {% if api_keys is defined and api_keys | length > 0 %}
            {% for key in api_keys %}
                <tr class="result-table__row">

                    <td class="result-table__cell result-table__cell--key-id">
                        {{ key.keyid }}
                    </td>

                    <td class="result-table__cell result-table__cell--owner">
                        {{ key.owner.fname }} {{ key.owner.lname }}
                    </td>

                    <td class="result-table__cell result-table__cell--owner">
                        {{ key.account.fname }} {{ key.account.lname}}
                    </td>

                    <td class="result-table__cell result-table__cell--access-key">
                        {{ key.access_key }}
                    </td>

                    <td class="result-table__cell result-table__cell--expires">
                        <time
                                class="result-table__time local-time"
                                datetime="{{ key.expires_at }}"
                                data-unix="{{ key.expires_at }}"
                            >
                                {{ key.expires_at }}
                            </time>
                    </td>

                    <td class="result-table__cell result-table__cell--created">
                        <time
                            class="result-table__time local-time"
                            datetime="{{ key.created_at }}"
                            data-unix="{{ key.created_at }}"
                        >
                            {{ key.created_at }}
                        </time>
                    </td>

                    <td class="result-table__cell result-table__cell--actions">
                        <div class="result-table__actions">
                            <form
                                action="/admin/keys/{{ key.uid }}/delete"
                                method="POST"
                                class="result-table__action-form"
                            >
                                <button
                                    onclick="return confirm('Are you sure you want to delete this asset?');"
                                    type="submit"
                                    class="btn btn-sm btn-danger"
                                >
                                    Delete
                                </button>
                            </form>
                        </div>
                    </td>

                </tr>
            {% endfor %}
        {% else %}
            <tr class="result-table__row result-table__row--empty">
                <td
                    class="result-table__cell result-table__cell--empty"
                    colspan="6"
                >
                    No API keys found.
                </td>
            </tr>
        {% endif %}
    </tbody>
</table>

{% endblock content %}
