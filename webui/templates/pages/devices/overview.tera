{% extends "layouts/device" %}

{% block title %}
    {{ device.name }} — OpenFab
{% endblock title %}

{% block content %}
    <div class="printer-view-page">
        <!-- Render the Lit component, passing parameters down via HTML attributes -->
        <device-view 
            printer-id="{{ device.uid }}"
            {% if camera_url is defined and camera_url is not none %}camera-url="{{ camera_url }}"{% endif %}
        ></device-view>
    </div>
{% endblock content %}