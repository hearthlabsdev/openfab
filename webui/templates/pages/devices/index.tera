{% extends "layouts/base" %}

{% block content %}
<div class="container">

    <div class="page-header flex-between">

        <h1 class="title">Devices</h1>

        <a href="/devices/create" class="btn btn-primary">
            Add Device
        </a>

    </div>

    <table class="data-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Last Seen</th>
                <th>Status</th>
            </tr>
        </thead>

        <tbody>
            {% if printers is defined and printers | length > 0 %}
                {% for printer in printers %}
                    <tr class="data-row">

                        <td class="data-name">
                            {{ printer.name }}
                        </td>

                        <td class="data-last-seen">
                            {{ printer.last_seen }}
                        </td>

                        <td class="data-status">
                            <span class="status-badge status-{{ printer.status | lower }}">
                                {{ printer.status }}
                            </span>
                        </td>

                    </tr>
                {% endfor %}
            {% else %}
                <tr>
                    <td colspan="3" class="empty-state">
                        No devices found.
                    </td>
                </tr>
            {% endif %}
        </tbody>
    </table>

</div>
{% endblock content %}