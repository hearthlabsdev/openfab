{% extends "layouts/base" %}

{% block content %}

<div class="device-library">

    <div class="device-library-header">

        <div>
            <h1 class="device-library-title">Devices</h1>
            <p class="device-library-subtitle">
                Manage and monitor your connected 3D printers.
            </p>
        </div>

        <div class="device-library-actions">
            <a href="/devices/create" class="btn btn-primary">
                Add Device
            </a>
        </div>

    </div>

    {% if devices is defined and devices | length > 0 %}

        <div class="device-grid">

            {% for printer in devices %}

            <article class="device-card">

                <div class="device-card-header">

                    <div class="device-card-icon">
                        🖨
                    </div>

                    <span class="status-badge status-{{ printer.status | lower }}">
                        {{ printer.status }}
                    </span>

                </div>

                <div class="device-card-body">

                    <h3 class="device-card-title" title="{{ printer.name }}">
                        {{ printer.name }}
                    </h3>

                    <div class="device-card-meta local-time">
                        <span>Last seen</span>
                        <time
                                class="result-table__time local-time"
                                datetime="{{ printer.last_seen }}"
                                data-unix="{{ printer.last_seen }}"
                            >
                                {{ printer.last_seen }}
                            </time>    
                    </div>

                    <div class="device-card-footer">
                        
                        <a
                            href="/devices/{{ printer.uid }}"
                            class="btn btn-secondary"
                        >
                            View
                        </a>

                        <a 
                            href="/prints/create?device={{ printer.uid }}"
                            class="btn btn-primary">
                            Submit a Print
                        </a>

                    </div>

                </div>

            </article>

            {% endfor %}

        </div>

    {% else %}

        <div class="device-empty">
            <div class="device-empty-icon">🖨</div>

            <h2>No devices yet</h2>

            <p>
                Add a 3D printer to start monitoring and managing your devices.
            </p>

            <a href="/devices/create" class="btn btn-primary">
                Add Device
            </a>
        </div>

    {% endif %}

</div>
<script>
    document.querySelectorAll(".local-time").forEach(function (element) {
        const unix = Number(element.dataset.unix);

        if (!Number.isNaN(unix)) {
            element.textContent = new Date(unix * 1000).toLocaleString();
        }
    });
</script>
{% endblock content %}
