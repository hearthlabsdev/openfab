{% extends "layouts/base" %}

{% block content %}
<div class="container">

    <div class="page-header">
        <h1 class="title">Create Device</h1>
    </div>


    {# ============================================================
       DEVICE IDENTITY
       ============================================================ #}

    <div class="device-form">

        <div class="form-section">

            <div class="form-group">
                <label for="name">Device Name *</label>

                <input
                    type="text"
                    id="name"
                    name="name"
                    form="device-create-form"
                    required
                >
            </div>

        </div>


        {# ========================================================
           DRIVER SELECTION
           ======================================================== #}

        <div class="form-section">

            <div class="form-group">

                <label for="driver">Driver *</label>

                <select
                    id="driver"
                    name="driver"
                    required
                >
                    <option value="" disabled selected>
                        Select a driver
                    </option>

                    {% for driver in drivers %}

                    <option value="{{ driver.id }}">
                        {{ driver.name }} ({{ driver.version }})
                    </option>

                    {% endfor %}

                </select>

            </div>

        </div>

    </div>


    {# ============================================================
       DRIVER FORMS
       ============================================================ #}

    {% for driver in drivers %}

    <div
        class="device-form driver-form"
        id="driver-form-{{ driver.id }}"
        data-driver-id="{{ driver.id }}"
        style="display: none;"
    >

        <form
            id="{{ driver.id }}"
            action="/devices/create"
            method="POST"
        >

            {# ====================================================
               CORE DEVICE VALUES
               ==================================================== #}

            <input
                type="hidden"
                name="driver"
                value="{{ driver.id }}"
            >

            <input
                type="hidden"
                name="name"
                id="{{ driver.id }}-name"
            >


            {# ====================================================
               DRIVER CONFIGURATION
               ==================================================== #}

            {% if driver.schema.fields | length > 0 %}

            <div class="form-section">

                <h2>
                    {{ driver.name }} Configuration
                </h2>

                {% for field in driver.schema.fields %}

                <div class="form-group">

                    <label for="{{ driver.id }}-{{ field.name }}">
                        {{ field.label }}

                        {% if field.required %}
                            *
                        {% endif %}
                    </label>


                    {# ==================================================
                       TEXT
                       ================================================== #}

                    {% if field.field_type == "text" %}

                    <input
                        type="text"
                        id="{{ driver.id }}-{{ field.name }}"
                        name="{{ field.name }}"
                        {% if field.default is defined and field.default %}
                        value="{{ field.default }}"
                        {% endif %}
                        {% if field.required %}
                        required
                        {% endif %}
                    >


                    {# ==================================================
                       PASSWORD
                       ================================================== #}

                    {% elif field.field_type == "password" %}

                    <input
                        type="password"
                        id="{{ driver.id }}-{{ field.name }}"
                        name="{{ field.name }}"
                        {% if field.default is defined and field.default  %}
                        value="{{ field.default }}"
                        {% endif %}
                        {% if field.required %}
                        required
                        {% endif %}
                    >


                    {# ==================================================
                       NUMBER
                       ================================================== #}

                    {% elif field.field_type == "number" %}

                    <input
                        type="number"
                        id="{{ driver.id }}-{{ field.name }}"
                        name="{{ field.name }}"
                        {% if field.default is defined and field.default  %}
                        value="{{ field.default }}"
                        {% endif %}
                        {% if field.min is defined and field.min  %}
                        min="{{ field.min }}"
                        {% endif %}
                        {% if field.max is defined and field.max  %}
                        max="{{ field.max }}"
                        {% endif %}
                        {% if field.required %}
                        required
                        {% endif %}
                    >


                    {# ==================================================
                       FALLBACK
                       ================================================== #}

                    {% else %}

                    <input
                        type="text"
                        id="{{ driver.id }}-{{ field.name }}"
                        name="{{ field.name }}"
                        {% if field.default is defined and field.default  %}
                        value="{{ field.default }}"
                        {% endif %}
                        {% if field.required %}
                        required
                        {% endif %}
                    >

                    {% endif %}

                </div>

                {% endfor %}

            </div>

            {% endif %}


            {# ====================================================
               OPTIONAL METADATA
               ==================================================== #}

            <details class="advanced-section">

                <summary class="advanced-summary">
                    Additional Settings
                </summary>

                <div class="advanced-content">

                    <div class="form-group">

                        <label for="{{ driver.id }}-type">
                            Type
                        </label>

                        <select
                            id="{{ driver.id }}-type"
                            name="type"
                        >
                            <option value="printer">
                                Printer
                            </option>

                            <option value="scanner">
                                Scanner
                            </option>

                            <option value="copier">
                                Copier
                            </option>
                        </select>

                    </div>


                    <div class="form-group">

                        <label for="{{ driver.id }}-location">
                            Location
                        </label>

                        <input
                            type="text"
                            id="{{ driver.id }}-location"
                            name="location"
                        >

                    </div>


                    <div class="form-group">

                        <label for="{{ driver.id }}-model">
                            Model
                        </label>

                        <input
                            type="text"
                            id="{{ driver.id }}-model"
                            name="model"
                        >

                    </div>


                    <div class="form-group">

                        <label for="{{ driver.id }}-manufacturer">
                            Manufacturer
                        </label>

                        <input
                            type="text"
                            id="{{ driver.id }}-manufacturer"
                            name="manufacturer"
                        >

                    </div>


                    <div class="form-group">

                        <label for="{{ driver.id }}-serial_number">
                            Serial Number
                        </label>

                        <input
                            type="text"
                            id="{{ driver.id }}-serial_number"
                            name="serial_number"
                        >

                    </div>


                    <div class="form-group">

                        <label for="{{ driver.id }}-firmware_version">
                            Firmware Version
                        </label>

                        <input
                            type="text"
                            id="{{ driver.id }}-firmware_version"
                            name="firmware_version"
                        >

                    </div>


                    <div class="form-group">

                        <label for="{{ driver.id }}-mac_address">
                            MAC Address
                        </label>

                        <input
                            type="text"
                            id="{{ driver.id }}-mac_address"
                            name="mac_address"
                        >

                    </div>


                    <div class="form-group">

                        <label for="{{ driver.id }}-description">
                            Description
                        </label>

                        <textarea
                            id="{{ driver.id }}-description"
                            name="description"
                        ></textarea>

                    </div>

                </div>

            </details>


            {# ====================================================
               SUBMIT
               ==================================================== #}

            <div class="form-actions">

                <button
                    type="submit"
                    class="btn btn-primary"
                >
                    Create Device
                </button>

            </div>

        </form>

    </div>

    {% endfor %}


    {# ============================================================
       DISCOVERED DEVICES
       ============================================================ #}

    <div class="device-form">

        <h2>Discovered Devices</h2>

        {% if devices is defined and devices | length > 0 %}

        <table class="device-table">

            <thead>
                <tr>
                    <th>Host</th>
                    <th>Port</th>
                    <th>Discovered At</th>
                </tr>
            </thead>

            <tbody>

                {% for device in devices %}

                <tr>
                    <td>{{ device.host }}</td>
                    <td>{{ device.port }}</td>
                    <td>{{ device.discovered_at }}</td>
                </tr>

                {% endfor %}

            </tbody>

        </table>

        {% else %}

        <p>No devices discovered</p>

        {% endif %}

    </div>

</div>


{# ================================================================
   DRIVER FORM SELECTION
   ================================================================ #}

<script>
document.addEventListener("DOMContentLoaded", function () {

    const driverSelect = document.getElementById("driver");
    const driverForms = document.querySelectorAll(".driver-form");

    function updateDriverForm() {

        const selectedDriver = driverSelect.value;

        driverForms.forEach(function (form) {

            const driverId = form.dataset.driverId;

            if (driverId === selectedDriver) {
                form.style.display = "";
            } else {
                form.style.display = "none";
            }

        });
    }

    driverSelect.addEventListener("change", updateDriverForm);

    updateDriverForm();
});
</script>

{% endblock content %}
