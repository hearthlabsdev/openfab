{% extends "layouts/base" %}

{% block content %}
<div class="container">

    <div class="page-header">
        <h1 class="title">Create Device</h1>
    </div>

    <div class="device-form">
    <form action="/devices" method="POST" class="device-form">

        {# =========================
           CORE IDENTITY
        ========================= #}

        <div class="form-section">

            <div class="form-group">
                <label for="name">Device Name *</label>
                <input type="text" id="name" name="name" required>
            </div>

        </div>


        {# =========================
           CONNECTION METHOD (EXCLUSIVE OR)
        ========================= #}

        <div class="form-section">

            <div class="form-group">
                <label>Connection Method *</label>

                <div class="radio-group">
                    <label>
                        <input type="radio" name="connection_type" value="network" checked>
                        Network (IP Address)
                    </label>

                    <label>
                        <input type="radio" name="connection_type" value="serial">
                        Serial Port
                    </label>
                </div>
            </div>

            <div class="form-group" id="ip-field">
                <label for="ip_address">IP Address *</label>
                <input type="text" id="ip_address" name="ip_address" placeholder="192.168.1.50">
            </div>

            <div class="form-group" id="serial-field">
                <label for="serial_port">Serial Port *</label>
                <input type="text" id="serial_port" name="serial_port" placeholder="/dev/ttyUSB0">
            </div>

        </div>


        <div class="form-group">
            <label for="protocol">Driver Protocol</label>

            <select id="protocol" name="protocol" required>
                <option value="" disabled selected>Select a protocol</option>

                <optgroup label="IPP Family">
                    <option value="ipp">IPP (Internet Printing Protocol)</option>
                    <option value="ipps">IPPS (IPP over TLS)</option>
                    <option value="ipp3d">IPP3D (3D Printing Extensions)</option>
                </optgroup>

                <optgroup label="Raw Network Printing">
                    <option value="jetdirect">JetDirect / RAW 9100</option>
                    <option value="lpd">LPD (Line Printer Daemon)</option>
                </optgroup>

                <optgroup label="Vendor / Ecosystem APIs">
                    <option value="prusalink">PrusaLink API</option>
                    <option value="bambu_lan">Bambu LAN Mode</option>
                    <option value="moonraker">Klipper / Moonraker API</option>
                </optgroup>

                <optgroup label="Generic / Advanced">
                    <option value="http">Generic HTTP API</option>
                    <option value="custom">Custom Driver (Advanced)</option>
                </optgroup>

                <optgroup label="Serial Drivers">
                    <option value="marlin">Marlin (G-code over Serial)</option>
                    <option value="klipper">Klipper (Moonraker)</option>
                    <option value="generic_gcode">Generic G-code Device</option>
                </optgroup>
            </select>
        </div>
        <br/>

        {# =========================
           OPTIONAL METADATA
        ========================= #}

        <details class="advanced-section">
            <summary class="advanced-summary">
                Additional Settings
            </summary>

            <div class="advanced-content">

                <div class="form-group">
                    <label for="type">Type</label>
                    <select id="type" name="type">
                        <option value="printer">Printer</option>
                        <option value="scanner">Scanner</option>
                        <option value="copier">Copier</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="location">Location</label>
                    <input type="text" id="location" name="location">
                </div>

                <div class="form-group">
                    <label for="model">Model</label>
                    <input type="text" id="model" name="model">
                </div>

                <div class="form-group">
                    <label for="manufacturer">Manufacturer</label>
                    <input type="text" id="manufacturer" name="manufacturer">
                </div>

                <div class="form-group">
                    <label for="serial_number">Serial Number</label>
                    <input type="text" id="serial_number" name="serial_number">
                </div>

                <div class="form-group">
                    <label for="firmware_version">Firmware Version</label>
                    <input type="text" id="firmware_version" name="firmware_version">
                </div>

                <div class="form-group">
                    <label for="mac_address">MAC Address</label>
                    <input type="text" id="mac_address" name="mac_address">
                </div>

                <div class="form-group">
                    <label for="description">Description</label>
                    <textarea id="description" name="description"></textarea>
                </div>

            </div>
        </details>


        {# =========================
           SUBMIT
        ========================= #}

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                Create Device
            </button>
        </div>

    </form>
    </div>
    <div class="device-form">
        <h2>
            Discovered Devices
        </h2>
        {% if devices is defined and devices | length > 0 %}
        <table class="device-table">
            <tr>
                <th>
                    Host
                </th>
                <th>
                    Port
                </th>
                <th>
                    Discovered At
                </th>
            </tr>
            {% for device in devices %}
                <tr>
                    <th>
                        {{ device.host }}
                    </th>
                    <th>
                        {{ device.port }}
                    </th>
                    <th>
                        {{ device.discovered_at }}
                    </th>
                </tr>
            {% endfor %}
        </table>
        {% else %}
            <p>No devices discovered</p>
        {% endif %}
    </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", () => {
    const networkRadio = document.querySelector('input[value="network"]');
    const serialRadio = document.querySelector('input[value="serial"]');

    const ipField = document.getElementById("ip-field");
    const serialField = document.getElementById("serial-field");

    function update() {
        if (networkRadio.checked) {
            ipField.style.display = "block";
            serialField.style.display = "none";
        } else {
            ipField.style.display = "none";
            serialField.style.display = "block";
        }
    }

    networkRadio.addEventListener("change", update);
    serialRadio.addEventListener("change", update);

    update();
});
</script>

{% endblock content %}