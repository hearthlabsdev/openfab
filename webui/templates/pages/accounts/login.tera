{% extends "layouts/accounts" %}

{% block title %}Login{% endblock title %}

{% block content %}
    <style>
        .error-banner {
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
            padding: 12px 16px;
            border-radius: 6px;
            margin-bottom: 20px;
            font-size: 0.95rem;
            line-height: 1.4;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .error-banner svg {
            width: 20px;
            height: 20px;
            flex-shrink: 0;
            stroke: currentColor;
        }
    </style>

    <form method="post" action="/accounts/login">
        <h1>Login</h1>

        {% if error is defined and error %}
            <div class="error-banner" role="alert">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <span>{{ error }}</span>
            </div>
        {% endif %}

        <label for="email">Email:</label>
        <input type="text" id="email" name="email" required>

        <label for="password">Password:</label>

        <div class="password-wrapper">
            <input type="password" id="password" name="password" required>

            <button
                type="button"
                class="password-toggle"
                onclick="togglePassword('password')"
                aria-label="Show password"
                title="Show password"
            >
                <svg
                    class="eye-icon"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/>
                    <circle cx="12" cy="12" r="3"/>
                </svg>
            </button>
        </div>

        {% if redirect is defined %}
            <input type="hidden" name="redirect" value="{{ redirect }}"/>
        {% endif %}
        <button type="submit" class="login-button">Login</button>

        {% if config is defined and config.allow_registration %}
            <a href="/accounts/register">Don't have an account? Register here.</a>
        {% endif %}
    
        {% if providers is defined and providers | length > 0 %}
            <div class="oidc-section">
                <button
                    type="button"
                    class="oidc-toggle"
                    onclick="this.parentElement.classList.toggle('open')"
                >
                    <span>Login with SSO</span>
                    <span class="chevron">▾</span>
                </button>

                <div class="oidc-list">
                    {% for provider in providers %}
                        <a href="/auth/authorize?issuer_url={{ provider.issuer_url }}" class="oidc-provider">
                            {{ provider.name }}
                        </a>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

    </form>

{% endblock content %}