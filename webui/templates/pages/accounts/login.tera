{% extends "layouts/accounts" %}

{% block title %}Login{% endblock title %}

{% block content %}
    
    <form method="post" action="/accounts/login">
        <h1>Login</h1>

        <label for="username">Email:</label>
        <input type="text" id="email" name="email" required>

        <label for="password">Password:</label>

        <div class="password-wrapper">
            <input type="password" id="password" name="password" required>

            <button
                type="button"
                class="password-toggle"
                onclick="togglePassword('password')"
                aria-label="Show password"
                title="Show password"
            >
                <svg
                    class="eye-icon"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/>
                    <circle cx="12" cy="12" r="3"/>
                </svg>
            </button>
        </div>

        <button type="submit" class="login-button">Login</button>

        {% if config is defined and config.allow_registration %}
            <a href="/accounts/register">Don't have an account? Register here.</a>
        {% endif %}
    
        {% if providers is defined and providers | length > 0 %}
            <div class="oidc-section">
                <button
                    type="button"
                    class="oidc-toggle"
                    onclick="this.parentElement.classList.toggle('open')"
                >
                    <span>Login with SSO</span>
                    <span class="chevron">▾</span>
                </button>

                <div class="oidc-list">
                    {% for provider in providers %}
                        <a href="/auth/oidc/{{ provider.id }}" class="oidc-provider">
                            {{ provider.name }}
                        </a>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

    </form>

{% endblock content %}