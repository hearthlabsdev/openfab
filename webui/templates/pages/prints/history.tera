{% extends "layouts/base" %}

{% block content %}
<div class="container">

    <div class="page-header flex-between">
        <h1 class="title">Print History</h1>

        <a href="/prints/create" class="btn btn-primary">
            Submit New Print Job
        </a>
    </div>

    <table class="data-table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Submitted</th>
                <th>Status</th>
            </tr>
        </thead>

        <tbody>
            {% if prints is defined and prints | length > 0 %}
                {% for print in prints %}
                    <tr class="data-row">

                        <td class="data-title">
                            {{ print.title }}
                        </td>

                        <td class="data-submitted">
                            {{ print.submitted }}
                        </td>

                        <td class="data-status">
                            <span class="status-badge status-{{ print.status | lower }}">
                                {{ print.status }}
                            </span>
                        </td>

                    </tr>
                {% endfor %}
            {% else %}
                <tr>
                    <td colspan="3" class="empty-state">
                        No print jobs found.
                    </td>
                </tr>
            {% endif %}
        </tbody>
    </table>
</div>
{% endblock content %}