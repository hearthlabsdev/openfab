{% extends "layouts/base" %}

{% block content %}
<div class="container">

    <div class="page-header">
        <h1 class="title">Submit Print Job</h1>
    </div>

    <form action="/prints/create" method="POST" enctype="multipart/form-data" class="device-form">

        {# =========================
           CORE: TARGET + FILE
        ========================= #}

        <div class="form-section form-section-core">

            <div class="form-group">
                {% if device is defined and device is not none %}
                    <input type="hidden" value="{{ device }}"/>
                {% elif queue is defined and queue is not none %}
                    <input type="hidden" value="{{ queue }}"/>
                {% else %}
                    <label for="device_id">Device *</label>
                    <select id="device_id" name="device" required>
                        <option value="" disabled selected>Select a device</option>

                        {% if devices is defined %}
                            {% for device in devices %}
                                <option value="{{ device.uid }}">
                                    {{ device.name }}
                                </option>
                            {% endfor %}
                        {% endif %}
                    </select>
                {% endif %}
            </div>

            {% if asset is defined and asset is not none %}
                <input type="hidden" name="asset" value="{{ asset }}"/>
            {% else %}
            <div class="form-group">
                <label for="file">Print File *</label>
                <input type="file" id="file" name="file" required>
            </div>
            {% endif %}

        </div>


        {# =========================
           BASIC OPTIONS
        ========================= #}

        <div class="form-section">

            <div class="form-group">
                <label for="name">Job Name</label>
                <input type="text" id="name" name="name" required>
            </div>

            <div class="form-group">
                <label for="copies">Copies</label>
                <input type="number" id="copies" name="copies" value="1" min="1">
            </div>

            <div class="form-group">
                <label for="priority">Priority</label>
                <select id="priority" name="priority">
                    <option value="normal" selected>Normal</option>
                    <option value="high">High</option>
                    <option value="low">Low</option>
                </select>
            </div>

        </div>


        {# =========================
           ADVANCED SETTINGS
        ========================= #}

        <details class="advanced-section">
            <summary class="advanced-summary">
                Advanced Settings
            </summary>

            <div class="advanced-content">

                <div class="form-group">
                    <label for="material">Material</label>
                    <input type="text" id="material" name="material" placeholder="PLA, PETG, etc">
                </div>

                <div class="form-group">
                    <label for="nozzle_temp">Nozzle Temperature (°C)</label>
                    <input type="number" id="nozzle_temp" name="nozzle_temp">
                </div>

                <div class="form-group">
                    <label for="bed_temp">Bed Temperature (°C)</label>
                    <input type="number" id="bed_temp" name="bed_temp">
                </div>

                <div class="form-group">
                    <label for="layer_height">Layer Height (mm)</label>
                    <input type="number" step="0.01" id="layer_height" name="layer_height">
                </div>

                <div class="form-group">
                    <label for="infill">Infill (%)</label>
                    <input type="number" id="infill" name="infill" min="0" max="100">
                </div>

                <div class="form-group">
                    <label for="supports">Supports</label>
                    <select id="supports" name="supports">
                        <option value="none">None</option>
                        <option value="buildplate">Build Plate Only</option>
                        <option value="everywhere">Everywhere</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="notes">Notes</label>
                    <textarea id="notes" name="notes"></textarea>
                </div>

            </div>
        </details>


        {# =========================
           ACTIONS
        ========================= #}

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                Submit Print Job
            </button>
        </div>

    </form>
</div>
{% endblock content %}